<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <!--
        spring-boot-starter-parent gives us:
          - Dependency version management (no need to specify versions manually)
          - Default plugin configurations (compiler, surefire, etc.)
          - Sensible defaults for Spring Boot apps
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.4</version>
        <relativePath/>
    </parent>

    <!-- Project coordinates -->
    <groupId>com.example</groupId>
    <artifactId>student-management-system</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>student-management-system</name>
    <description>Student Management System – Spring Boot learning project</description>

    <properties>
        <java.version>21</java.version>
    </properties>

    <dependencies>

        <!--
            Spring Web: brings in Spring MVC + embedded Tomcat server.
            Lets us write @RestController, @GetMapping, @PostMapping, etc.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Data JPA: abstracts away all the boilerplate JDBC code.
            Gives us JpaRepository with built-in CRUD + pagination methods.
            Also pulls in Hibernate as the default JPA implementation.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            Bean Validation (Jakarta Validation API + Hibernate Validator).
            Enables @NotBlank, @Email, @Past, @Size, etc. on DTO fields.
            Spring Boot auto-wires this with @Valid on controller method params.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            MySQL JDBC Driver: the low-level connector that lets Hibernate
            actually talk to a MySQL database.
            'runtime' scope = only needed when the app runs, not during compilation.
        -->
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- H2 In-Memory Database for instant local testing without MySQL setup -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            DevTools: speeds up development.
            - Automatic restart when classpath changes
            - LiveReload support
            - Disabled in production builds automatically
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>

        <!--
            Lombok: reduces boilerplate with annotations like @Getter, @Setter,
            @NoArgsConstructor, @AllArgsConstructor, @Builder.
            The annotation processor generates the code at compile time.
        -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot Test: JUnit 5, Mockito, AssertJ for testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!--
                spring-boot-maven-plugin: packages the app as a self-contained
                "fat JAR" that includes the embedded Tomcat server.
                excludes Lombok from the final artifact (it's compile-time only).
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.example.studentmanagement.StudentManagementApplication</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
